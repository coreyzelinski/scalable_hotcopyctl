#!/usr/bin/perl

# hotcopyctl - Corey Zelinski <Corey.Zelinski@IEEE.org>
# Scalable wrapper for mysqlhotcopy

use strict;
use warnings;
use Getopt::Long qw(GetOptions);
use File::Basename qw(basename);
use File::Find qw(find);
use File::Path qw(make_path);

my ($Backup_Dir, $Daily, $Weekly, $BackupDB);
my ($HardLink, $GzipOld, $DeleteOldGzip, $ExcludeTables, $ShowHelp);
my ($Quiet, $Detail, $DatabaseBinLog_MaxDayAge, $LogFile, $DryRun);
my ($Delta_Dir, $BinLog_Dir, $MysqlUser, $MysqlDatabase, $MysqlHotcopyPath);

my $ForceRemoveLockfile = 1;
my $BinLogBatchSize     = 512;
my $ForceRMBinLogs      = 0;
my $PurgeSQLBinLogs     = 0;
my $BinLogCleanup       = 0;

sub usage {
    print <<'USAGE';
Usage: hotcopyctl [OPTIONS]... [MYSQLHOTCOPY_OPTIONS...]
Manages MySQL backups using mysqlhotcopy with additional safety and binlog cleanup.

Backup options:
  --database                 Perform a full mysqlhotcopy backup
  --backupdir <dir>          Full-backup destination (default: /data/new_mysql_backup)
  --delta-dir <dir>          Incremental/delta destination (default: /data/mysql_deltas)
  --exclude-tables <regex>   Exclude table names matching a Perl regular expression
  --mysql-user <user>        MySQL user (default: HOTCOPYCTL_MYSQL_USER or root)
  --mysql-database <name>    Database to back up (default: HOTCOPYCTL_MYSQL_DATABASE or application)
  --mysql-hotcopy <path>     mysqlhotcopy executable (default: /usr/bin/mysqlhotcopy)

Binlog cleanup options:
  --binlog-cleanup           Enable safe SQL binlog purge (default age: 90 days)
  --max-binlog-days <n>      Retain binlogs newer than n days; enables cleanup
  --purge-binary-logs        Purge with SQL (recommended)
  --force-rm-binlogs         Delete old binlogs from the filesystem (dangerous)
  --binlog-dir <dir>         Filesystem binlog directory (default: /var/lib/mysql/binlogs)
  --binlog-batch-size <n>    Files per filesystem-deletion batch (default: 512)

Execution/logging:
  --logfile <path>           Append timestamped logs to a file
  --quiet                    Suppress normal stdout messages
  --detail                   Emit verbose diagnostic messages
  --force / --no-force       Allow/disallow stale lockfile removal (default: allow)
  --dry-run                  Show intended changes without running backup/delete operations
  --help                     Show this help message

Compatibility options accepted from the historical script:
  --daily --weekly --hardlink --gzip-old --delete-old-gzip
  These are retained for CLI compatibility but currently do not alter backup policy.

Credentials:
  No password is stored in this script. If password authentication is required,
  set HOTCOPYCTL_MYSQL_PASSWORD in the environment or configure MySQL defaults
  for the account running hotcopyctl. Passwords are never written to the log.

Examples:
  hotcopyctl --database --backupdir=/data/mysql_backup --exclude-tables 'LongitudinalSeries_.*'
  hotcopyctl --binlog-cleanup --max-binlog-days=30 --dry-run
USAGE
}

GetOptions(
    'daily'                 => \$Daily,
    'weekly'                => \$Weekly,
    'database'              => \$BackupDB,
    'backupdir=s'           => \$Backup_Dir,
    'delta-dir=s'           => \$Delta_Dir,
    'exclude-tables=s'      => \$ExcludeTables,
    'hardlink'              => \$HardLink,
    'gzip-old'              => \$GzipOld,
    'delete-old-gzip'       => \$DeleteOldGzip,
    'quiet'                 => \$Quiet,
    'detail'                => \$Detail,
    'max-binlog-days=i'     => \$DatabaseBinLog_MaxDayAge,
    'binlog-batch-size=i'   => \$BinLogBatchSize,
    'purge-binary-logs'     => \$PurgeSQLBinLogs,
    'force-rm-binlogs'      => \$ForceRMBinLogs,
    'binlog-cleanup'        => \$BinLogCleanup,
    'binlog-dir=s'          => \$BinLog_Dir,
    'mysql-user=s'          => \$MysqlUser,
    'mysql-database=s'      => \$MysqlDatabase,
    'mysql-hotcopy=s'       => \$MysqlHotcopyPath,
    'logfile=s'             => \$LogFile,
    'force!'                => \$ForceRemoveLockfile,
    'dry-run'               => \$DryRun,
    'help'                  => \$ShowHelp,
) or do {
    usage();
    exit 2;
};

if ($ShowHelp) {
    usage();
    exit 0;
}

# Historical compatibility flags were never wired to complete policy logic.
# Keep accepting them so existing invocations do not fail, but say so clearly.
my @compat_flags;
push @compat_flags, '--daily'           if $Daily;
push @compat_flags, '--weekly'          if $Weekly;
push @compat_flags, '--hardlink'        if $HardLink;
push @compat_flags, '--gzip-old'        if $GzipOld;
push @compat_flags, '--delete-old-gzip' if $DeleteOldGzip;

my $mysql_user       = $MysqlUser        // $ENV{HOTCOPYCTL_MYSQL_USER}     // 'root';
my $mysql_passwd     = $ENV{HOTCOPYCTL_MYSQL_PASSWORD};
my $mysql_defaults    = $ENV{HOTCOPYCTL_MYSQL_DEFAULT_FILE};
my $mysql_dbname     = $MysqlDatabase    // $ENV{HOTCOPYCTL_MYSQL_DATABASE} // 'application';
my $mysql_hotcopy    = $MysqlHotcopyPath // '/usr/bin/mysqlhotcopy';
my $backup_dir       = $Backup_Dir       // '/data/new_mysql_backup';
my $delta_dir        = $Delta_Dir        // '/data/mysql_deltas';
my $binlog_dir       = $BinLog_Dir       // '/var/lib/mysql/binlogs';
my $lock_file        = '/tmp/hotcopyctl.lock';
my $last_backup_file = "$backup_dir/last_backup_time.txt";
my @mysqlhotcopy_extra_options = @ARGV;
my $lock_owned = 0;
my $did_backup = 0;

$BinLogCleanup = 1 if defined($DatabaseBinLog_MaxDayAge) || $PurgeSQLBinLogs || $ForceRMBinLogs;
$PurgeSQLBinLogs = 1 if $BinLogCleanup && !$PurgeSQLBinLogs && !$ForceRMBinLogs;
$DatabaseBinLog_MaxDayAge = 90 unless defined $DatabaseBinLog_MaxDayAge;
if ($DatabaseBinLog_MaxDayAge < 0) {
    die "hotcopyctl FATAL: --max-binlog-days must be zero or greater\n";
}
if ($BinLogBatchSize < 1) {
    die "hotcopyctl FATAL: --binlog-batch-size must be at least 1\n";
}

sub log_line {
    my ($level, $message, $to_stdout) = @_;
    if ($LogFile) {
        open(my $fh, '>>', $LogFile)
            or die "hotcopyctl FATAL: Could not open log file $LogFile: $!\n";
        print {$fh} scalar(localtime) . " [$level] $message\n";
        close($fh);
    }
    print "$message\n" if $to_stdout;
}

sub log_info {
    my ($message) = @_;
    log_line('INFO', $message, !$Quiet);
}

sub log_detail {
    my ($message) = @_;
    log_line('DETAIL', $message, !$Quiet && $Detail);
}

sub log_warn {
    my ($message) = @_;
    log_line('WARN', $message, !$Quiet);
}

sub shell_display {
    return join(' ', map {
        my $arg = defined($_) ? $_ : '';
        $arg =~ s/'/'"'"'/g;
        "'$arg'";
    } @_);
}

sub ensure_dir {
    my ($dir) = @_;
    return if -d $dir;
    if ($DryRun) {
        log_info("hotcopyctl DRY-RUN: would create directory $dir");
        return;
    }
    make_path($dir, { mode => 0750 })
        or die "hotcopyctl FATAL: Could not create directory $dir: $!\n";
}

sub connect_db {
    my ($database) = @_;
    require DBI;

    my $dsn = "DBI:mysql:database=$database";
    my $attempts = 3;
    my $last_error = '';

    for my $try (1 .. $attempts) {
        my %attrs = (
            RaiseError => 1,
            PrintError => 0,
            AutoCommit => 1,
            mysql_read_default_group => 'client',
        );
        $attrs{mysql_read_default_file} = $mysql_defaults
            if defined($mysql_defaults) && length($mysql_defaults);

        my $dbh = eval {
            DBI->connect(
                $dsn,
                $mysql_user,
                $mysql_passwd,
                \%attrs,
            );
        };
        return $dbh if $dbh;

        $last_error = $@ || 'unknown DBI error';
        chomp $last_error;
        log_warn("hotcopyctl WARN: MySQL connection attempt $try/$attempts failed: $last_error");
        sleep 5 if $try < $attempts;
    }

    die "hotcopyctl FATAL: Database connection failed after $attempts attempts: $last_error\n";
}

sub disconnect_db {
    my ($dbh) = @_;
    return unless $dbh;
    eval { $dbh->disconnect; 1 }
        or log_warn("hotcopyctl WARN: Database disconnect failed: $@");
}

sub compile_exclude_regex {
    return undef unless defined($ExcludeTables) && length($ExcludeTables);
    my $re = eval { qr/$ExcludeTables/ };
    die "hotcopyctl FATAL: Invalid --exclude-tables regex '$ExcludeTables': $@\n" if $@;
    return $re;
}

sub fetch_tables {
    my ($dbh, $exclude_re) = @_;
    my $rows = $dbh->selectall_arrayref(
        'SELECT table_name FROM information_schema.tables WHERE table_schema = ? ORDER BY table_name',
        undef,
        $mysql_dbname,
    );

    my @tables = map { $_->[0] } @$rows;
    if ($exclude_re) {
        my @excluded = grep { $_ =~ $exclude_re } @tables;
        @tables = grep { $_ !~ $exclude_re } @tables;
        log_detail('hotcopyctl DEBUG: Tables excluded: ' . join(', ', @excluded)) if @excluded;
        log_warn("hotcopyctl WARN: No tables matched exclusion regex '$ExcludeTables'") unless @excluded;
    }
    return @tables;
}

sub fetch_changed_tables {
    my ($dbh, $since, $exclude_re) = @_;
    # Some engines expose NULL update_time. Treat those as changed rather than risk
    # silently omitting data from an incremental backup.
    my $rows = $dbh->selectall_arrayref(
        q{
            SELECT table_name
              FROM information_schema.tables
             WHERE table_schema = ?
               AND (update_time IS NULL OR update_time > FROM_UNIXTIME(?))
             ORDER BY table_name
        },
        undef,
        $mysql_dbname,
        $since,
    );

    my @tables = map { $_->[0] } @$rows;
    @tables = grep { $_ !~ $exclude_re } @tables if $exclude_re;
    return @tables;
}

sub run_command_with_retries {
    my ($label, $attempts, @cmd) = @_;
    log_detail("hotcopyctl DEBUG: $label command: " . shell_display(@cmd));

    if ($DryRun) {
        log_info("hotcopyctl DRY-RUN: would run $label: " . shell_display(@cmd));
        return 1;
    }

    my $wait = 5;
    for my $try (1 .. $attempts) {
        my $status = system { $cmd[0] } @cmd;
        if ($status == 0) {
            log_info("hotcopyctl INFO: $label completed successfully") if $try > 1;
            return 1;
        }

        my $exit_code = $status == -1 ? "exec failed: $!" : ($status >> 8);
        log_warn("hotcopyctl WARN: $label attempt $try/$attempts failed ($exit_code)");
        last if $try == $attempts;
        log_info("hotcopyctl INFO: Retrying $label in $wait seconds...");
        sleep $wait;
        $wait *= 2;
        $wait = 30 if $wait > 30;
    }

    return 0;
}

sub mysqlhotcopy_args {
    my ($tables_ref, $target, $is_delta) = @_;
    my @tables = @$tables_ref;
    return () unless @tables;

    my $table_pattern = join('|', map { quotemeta($_) } @tables);
    my @cmd = (
        $mysql_hotcopy,
        "--user=$mysql_user",
    );

    # Keep credentials out of source control and logs. MYSQL_PWD is inherited by
    # mysqlhotcopy when HOTCOPYCTL_MYSQL_PASSWORD is supplied.
    push @cmd, '--addtodest' if $is_delta;
    if (!$is_delta) {
        push @cmd, '--allowold', '--keepold';
    }
    push @cmd,
        '--flushlog',
        '--record_log_pos',
        "$mysql_dbname.log_pos",
        "$mysql_dbname./\\b($table_pattern)\\b/",
        $target,
        @mysqlhotcopy_extra_options;

    return @cmd;
}

sub read_last_backup_time {
    return 0 unless -r $last_backup_file;
    open(my $fh, '<', $last_backup_file)
        or die "hotcopyctl FATAL: Cannot open $last_backup_file: $!\n";
    my $line = <$fh>;
    close($fh);
    chomp($line //= '');
    return $line =~ /^\d+$/ ? 0 + $line : 0;
}

sub write_last_backup_time {
    my ($timestamp) = @_;
    if ($DryRun) {
        log_info("hotcopyctl DRY-RUN: would write backup timestamp $timestamp to $last_backup_file");
        return;
    }
    open(my $fh, '>', $last_backup_file)
        or die "hotcopyctl FATAL: Could not write $last_backup_file: $!\n";
    print {$fh} "$timestamp\n";
    close($fh) or die "hotcopyctl FATAL: Could not close $last_backup_file: $!\n";
}

sub acquire_lock {
    return if $DryRun;

    if (-e $lock_file) {
        open(my $fh, '<', $lock_file)
            or die "hotcopyctl FATAL: Unable to open lockfile $lock_file: $!\n";
        my $old_pid = <$fh>;
        close($fh);
        chomp($old_pid //= '');

        if ($old_pid =~ /^\d+$/ && kill(0, $old_pid)) {
            die "hotcopyctl FATAL: Another hotcopyctl process is running under PID $old_pid\n";
        }
        if (!$ForceRemoveLockfile) {
            die "hotcopyctl FATAL: Stale or invalid lockfile $lock_file exists; rerun with --force or remove it manually\n";
        }
        log_warn("hotcopyctl WARN: Removing stale lockfile $lock_file");
        unlink($lock_file)
            or die "hotcopyctl FATAL: Could not remove stale lockfile $lock_file: $!\n";
    }

    open(my $fh, '>', $lock_file)
        or die "hotcopyctl FATAL: Could not create lockfile $lock_file: $!\n";
    print {$fh} "$$\n";
    close($fh);
    $lock_owned = 1;
}

sub release_lock {
    return unless $lock_owned && -e $lock_file;
    if (open(my $fh, '<', $lock_file)) {
        my $pid = <$fh>;
        close($fh);
        chomp($pid //= '');
        unlink($lock_file) if $pid eq "$$";
    }
    $lock_owned = 0;
}

END {
    release_lock();
}

sub purge_binlogs_sql {
    return 1 unless $PurgeSQLBinLogs;

    my $dbh = connect_db('mysql');
    my $days = 0 + $DatabaseBinLog_MaxDayAge;
    my $sql = "PURGE BINARY LOGS BEFORE DATE_SUB(NOW(), INTERVAL $days DAY)";

    if ($DryRun) {
        log_info("hotcopyctl DRY-RUN: would execute SQL: $sql");
        disconnect_db($dbh);
        return 1;
    }

    my $ok = eval {
        $dbh->do($sql);
        1;
    };
    if (!$ok) {
        my $err = $@ || 'unknown SQL error';
        disconnect_db($dbh);
        log_warn("hotcopyctl ERROR: SQL binlog purge failed: $err");
        return 0;
    }

    disconnect_db($dbh);
    log_info("hotcopyctl INFO: Successfully purged binlogs older than $days days using SQL");
    return 1;
}

sub old_binlog_files {
    my $cutoff = time - ($DatabaseBinLog_MaxDayAge * 86400);
    my @files;

    find(
        {
            no_chdir => 1,
            wanted => sub {
                return unless -f $_;
                my $name = basename($_);
                return unless $name =~ /(?:\.binlog|\.\d{6})$/;
                my @st = stat($_);
                return unless @st && $st[9] < $cutoff;
                push @files, $File::Find::name;
            },
        },
        $binlog_dir,
    );

    return sort @files;
}

sub delete_file_batches {
    my (@files) = @_;
    my @failed;

    while (@files) {
        my @batch = splice(@files, 0, $BinLogBatchSize);
        if ($DryRun) {
            log_info('hotcopyctl DRY-RUN: would delete binlogs: ' . join(', ', @batch));
            next;
        }

        for my $file (@batch) {
            if (!unlink($file) && -e $file) {
                push @failed, $file;
            }
        }
    }
    return @failed;
}

sub purge_binlogs_filesystem {
    return 1 unless $ForceRMBinLogs;

    if (!-d $binlog_dir) {
        log_warn("hotcopyctl ERROR: Binlog directory $binlog_dir does not exist");
        return 0;
    }

    my @files = old_binlog_files();
    if (!@files) {
        log_info("hotcopyctl INFO: No filesystem binlogs older than $DatabaseBinLog_MaxDayAge days found");
        return 1;
    }

    log_warn("hotcopyctl WARN: Direct filesystem deletion is enabled for " . scalar(@files) . ' binlog file(s)');
    my @remaining = delete_file_batches(@files);
    if (@remaining) {
        log_warn('hotcopyctl WARN: Retrying ' . scalar(@remaining) . ' binlog file(s) that still exist');
        @remaining = delete_file_batches(@remaining);
    }

    if (@remaining) {
        log_warn('hotcopyctl ERROR: Failed to delete binlogs: ' . join(', ', @remaining));
        return 0;
    }

    log_info('hotcopyctl INFO: Filesystem binlog cleanup completed successfully');
    return 1;
}

log_info('hotcopyctl INFO: Initiating backup policy...');
log_warn('hotcopyctl WARN: Compatibility flags currently have no policy effect: ' . join(', ', @compat_flags)) if @compat_flags;

if ($mysql_passwd) {
    $ENV{MYSQL_PWD} = $mysql_passwd;
}

if (@mysqlhotcopy_extra_options) {
    log_detail('hotcopyctl DEBUG: Extra mysqlhotcopy options: ' . shell_display(@mysqlhotcopy_extra_options));
}

acquire_lock();
ensure_dir($backup_dir);
ensure_dir($delta_dir);

my $exclude_re = compile_exclude_regex();
my $last_backup_time = read_last_backup_time();
my $this_backup_time = time;
my $backup_ok = 1;

# Only connect to the application database when backup work is requested.
# With no explicit --database flag, the historical behavior is incremental-only.
my $dbh = connect_db($mysql_dbname);
my @included_tables = fetch_tables($dbh, $exclude_re);
my @changed_tables  = fetch_changed_tables($dbh, $last_backup_time, $exclude_re);
disconnect_db($dbh);

if (!-x $mysql_hotcopy && !$DryRun) {
    die "hotcopyctl FATAL: Cannot find or execute $mysql_hotcopy\n";
}

if ($BackupDB) {
    if (@included_tables) {
        my @cmd = mysqlhotcopy_args(\@included_tables, $backup_dir, 0);
        $backup_ok &&= run_command_with_retries('FULL backup', 2, @cmd);
        $did_backup = 1;
    } else {
        log_warn('hotcopyctl WARN: No tables selected for full backup');
    }
}

if (@changed_tables) {
    my @cmd = mysqlhotcopy_args(\@changed_tables, $delta_dir, 1);
    $backup_ok &&= run_command_with_retries('INCREMENTAL backup', 4, @cmd);
    $did_backup = 1;
} else {
    log_info('hotcopyctl INFO: No changed tables detected for incremental backup');
}

if ($did_backup && $backup_ok) {
    write_last_backup_time($this_backup_time);
} elsif ($did_backup) {
    log_warn('hotcopyctl ERROR: Backup failed; last-backup timestamp was not advanced');
}

my $cleanup_ok = 1;
if ($BinLogCleanup) {
    if (!$backup_ok) {
        log_warn('hotcopyctl WARN: Skipping binlog cleanup because the backup phase failed');
        $cleanup_ok = 0;
    } else {
        $cleanup_ok &&= purge_binlogs_sql();
        $cleanup_ok &&= purge_binlogs_filesystem();
    }
}

release_lock();

exit(($backup_ok && $cleanup_ok) ? 0 : 1);

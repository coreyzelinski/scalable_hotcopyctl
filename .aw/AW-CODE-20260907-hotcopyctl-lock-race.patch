@@ -336,32 +338,34 @@ sub write_last_backup_time {
 sub acquire_lock {
     return if $DryRun;

-    if (-e $lock_file) {
-        open(my $fh, '<', $lock_file)
-            or die "hotcopyctl FATAL: Unable to open lockfile $lock_file: $!\n";
-        my $old_pid = <$fh>;
-        close($fh);
-        chomp($old_pid //= '');
-
-        if ($old_pid =~ /^\d+$/ && kill(0, $old_pid)) {
-            die "hotcopyctl FATAL: Another hotcopyctl process is running under PID $old_pid\n";
-        }
-        if (!$ForceRemoveLockfile) {
-            die "hotcopyctl FATAL: Stale or invalid lockfile $lock_file exists; rerun with --force or remove it manually\n";
-        }
-        log_warn("hotcopyctl WARN: Removing stale lockfile $lock_file");
-        unlink($lock_file)
-            or die "hotcopyctl FATAL: Could not remove stale lockfile $lock_file: $!\n";
-    }
-
-    open(my $fh, '>', $lock_file)
+    # Hold an advisory lock on a persistent inode for the process lifetime.
+    # The historical check-then-create PID file was racy: two simultaneous
+    # processes could both observe "no lock" and both become owners.
+    sysopen(my $fh, $lock_file, O_RDWR | O_CREAT, 0600)

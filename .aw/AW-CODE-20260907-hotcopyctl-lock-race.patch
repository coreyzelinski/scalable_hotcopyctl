+        die "hotcopyctl FATAL: Another hotcopyctl process is running$owner\n";
+    }
+
+    seek($fh, 0, SEEK_SET)
+        or die "hotcopyctl FATAL: Could not seek lockfile $lock_file: $!\n";
+    truncate($fh, 0)
+        or die "hotcopyctl FATAL: Could not truncate lockfile $lock_file: $!\n";
+    print {$fh} "$$\n"
+        or die "hotcopyctl FATAL: Could not write lockfile $lock_file: $!\n";
+
+    $lock_handle = $fh;
     $lock_owned = 1;
 }

 sub release_lock {
-    return unless $lock_owned && -e $lock_file;
-    if (open(my $fh, '<', $lock_file)) {
-        my $pid = <$fh>;
-        close($fh);
-        chomp($pid //= '');
-        unlink($lock_file) if $pid eq "$$";
-    }
+    return unless $lock_owned && $lock_handle;
+    flock($lock_handle, LOCK_UN);
+    close($lock_handle);
+    undef $lock_handle;
     $lock_owned = 0;
 }
